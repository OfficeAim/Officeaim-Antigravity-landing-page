# Public client-side variables (safe for browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only variables (Netlify Functions / local .env — NEVER prefix with VITE_)
GEMINI_API_KEY=your-gemini-api-key-here
# Server-side only: required by netlify/functions/gemini.js to call the service_role-only
# rate-limit RPC public.check_gemini_public_rate_limit(p_ip_hash, p_scope).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
